---
pagination:
  data: legacyRedirects
  size: 1
  alias: redirect
permalink: "{{ redirect.from }}index.html"
eleventyExcludeFromCollections: true
---
{#
  Redirect pages for the old marker.golf tutorial URLs (src/_data/legacyRedirects.json).
  GitHub Pages ignores _redirects, so each old path gets a real page: canonical link,
  immediate meta refresh, location.replace() and a visible link. Each page is a folder
  index, so the old path works with or without a trailing slash. Every URL goes through
  the url filter, so the pages work at the root and under the GitHub Pages path prefix.
  Checked by npm run check:redirects.
#}
{%- set destination = redirect.to | url -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ redirect.title }} | Marker Golf</title>
  <meta name="robots" content="noindex">
  <link rel="canonical" href="{{ destination }}">
  <meta http-equiv="refresh" content="0; url={{ destination }}">
  <script>location.replace({{ destination | dump | safe }});</script>
  <style>
    body { margin: 0; font-family: system-ui, -apple-system, sans-serif; background: #f5f2eb; color: #1b1c1b; }
    main { max-width: 32rem; margin: 0 auto; padding: 4rem 1rem; line-height: 1.6; }
    h1 { font-size: 1.5rem; margin: 0 0 0.5rem; }
    a { color: #314e36; font-weight: 600; }
  </style>
</head>
<body>
  <main>
    <h1>This tutorial has moved</h1>
    <p>Continue to <a href="{{ destination }}">{{ redirect.title }}</a>.</p>
  </main>
</body>
</html>
