{#
  DemoVideo(id, file, label, alt, description)
  ————————————————————————————————————————————
  A silent product demo inside the phone frame: VP9 WebM first, H.264 MP4
  (High, level 4.0) fallback, with the poster image. Native controls are the
  no-JavaScript fallback; main.js replaces them with the play/pause/replay
  button and handles viewport autoplay, reduced motion and Save-Data.

  id          — element id of the <video>; the description is `<id>-description`
  file        — base name in /images/video/ (`<file>.webm`, `<file>.mp4`,
                `<file>-poster.jpg`, all 780×1688)
  label       — accessible name of the video
  alt         — alt text of the poster fallback image
  description — visually hidden description of what the recording shows
                (author-written text; output as written, so no markup or
                untrusted input)

  Usage:
    {% from "components/demo-video.njk" import DemoVideo %}
    {{ DemoVideo("demo-video", "score-round-side-games", "Demo: …", "…", "…") }}
#}

{% macro DemoVideo(id, file, label, alt, description) %}
        <figure class="product-screenshot product-screenshot--phone demo-video" data-demo-video>
          <div class="product-screenshot__phone-frame">
            <div class="product-screenshot__phone-screen">
              <video id="{{ id }}" class="demo-video__media" width="780" height="1688"
                poster="{{ ('/images/video/' + file + '-poster.jpg') | url }}"
                muted playsinline loop controls preload="none"
                disablepictureinpicture disableremoteplayback controlslist="nodownload noplaybackrate noremoteplayback"
                aria-label="{{ label }}"
                aria-describedby="{{ id }}-description">
                <source src="{{ ('/images/video/' + file + '.webm') | url }}" type='video/webm; codecs="vp9"'>
                <source src="{{ ('/images/video/' + file + '.mp4') | url }}" type='video/mp4; codecs="avc1.640028"'>
                <img src="{{ ('/images/video/' + file + '-poster.jpg') | url }}" width="780" height="1688" alt="{{ alt }}">
              </video>
            </div>
          </div>
          <figcaption id="{{ id }}-description" class="visually-hidden">
            {{ description | safe }}
          </figcaption>
          <button type="button" class="demo-video__toggle" aria-controls="{{ id }}" hidden>
            <svg class="demo-video__icon demo-video__icon--play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"/></svg>
            <svg class="demo-video__icon demo-video__icon--pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor"/></svg>
            <svg class="demo-video__icon demo-video__icon--replay" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
            <span class="demo-video__label">Play demo</span>
          </button>
        </figure>
{% endmacro %}
