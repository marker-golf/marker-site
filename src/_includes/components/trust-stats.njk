{% macro TrustStats(stats) %}
{#
  Trust stats — counts come from src/_data/stats.js, which fetches them from
  the hub at build time and falls back to the last good response, then to
  src/_data/statsFallback.json. Pass the global `stats` in: imported macros
  cannot see global data.
#}
<div class="trust-stats" aria-label="Marker usage statistics">
  <div class="trust-stats__item">
    <span class="trust-stats__number">{{ stats.scorecards }}</span>
    <span class="trust-stats__label">Scorecards Created</span>
  </div>
  <div class="trust-stats__item">
    <span class="trust-stats__number">{{ stats.scores }}</span>
    <span class="trust-stats__label">Scores Recorded</span>
  </div>
  <div class="trust-stats__item">
    <span class="trust-stats__number">{{ stats.golfers }}</span>
    <span class="trust-stats__label">Golfers</span>
  </div>
  <div class="trust-stats__item">
    <span class="trust-stats__number">{{ stats.events }}</span>
    <span class="trust-stats__label">Events Managed</span>
  </div>
</div>
{% endmacro %}
